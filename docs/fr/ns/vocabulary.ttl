<https://pbisson44.github.io/ddigraph/ns/1.0/>
    a owl:Ontology ;
    dcterms:title "The ddigraph DDI vocabulary"@en ;
    dcterms:description "Classes and predicates for DDI metadata exported by ddigraph. Terms with a published equivalent in DISCO, XKOS or SKOS are declared as subclasses or subproperties of it rather than redefined."@en ;
